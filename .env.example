# Copy to .env.local for local work.
# On Netlify: Site → Environment variables.
# Do not commit real secrets.

# Pooled connection for the Next.js app (hostname includes -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection for Drizzle migrations (no -pooler)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth signing secret. Required in production. Generate with: openssl rand -base64 32
# AUTH_SECRET is accepted as a fallback so existing Netlify vars keep working.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_SECRET="replace-with-a-long-random-secret"

# Public origin of this deployment (no trailing slash). Local: http://localhost:3000
# Production: https://gcsworkhub.netlify.app
BETTER_AUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Temporary password shown when an admin/head invites someone
# (legacy seed/dev fallback only — invites now use email or per-person temp passwords)
INVITE_STARTER_PASSWORD="replace-with-a-strong-starter-password"

# Used only by `pnpm db:seed` (not required for the running app)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-me"
SEED_STAFF_PASSWORD="replace-me"
SEED_MD_EMAIL="md@example.com"

# n8n → WorkHub student ingest (Bearer token for POST /api/integrations/clients/students)
CLIENTS_INGEST_SECRET="replace-with-a-long-random-secret"

# Cloudinary (file uploads). Do not commit real secrets.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_ROOT_FOLDER="gcs-workhub"

# Gmail SMTP for invite + password-reset emails (use an App Password, not the account password)
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
GMAIL_FROM_NAME="GCS WorkHub"
